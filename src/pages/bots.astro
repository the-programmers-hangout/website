---
import Base from "../layouts/Base.astro"
import SitePageIsland from "../islands/SitePageIsland.tsx"
import { getSitePageData, getResourceData } from "../lib/content"

const data = await getSitePageData("/bots")
const resourceData = getResourceData()
---

<Base title="BOTS">
  <SitePageIsland
    client:only="react"
    pathname="/bots"
    headerTitle="Bots"
    html={data.html}
    headings={data.headings}
    resourceData={resourceData}
  />
</Base>
