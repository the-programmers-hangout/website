---
import { ClientRouter } from "astro:transitions"
import "../styles/global.css"
import "prismjs/themes/prism-tomorrow.css"

export interface Props {
  title: string
  description?: string
  subCategory?: string | null
  lang?: string
}

const { title, description, subCategory, lang = "en" } = Astro.props

const siteTitle = "The Programmers Hangout"
const siteDescription = "A cozy community of programmers on Discord"
const siteAuthor = "TPH Community"

const metaDescription = description || siteDescription
const displayTitle = subCategory ? `${title} - ${subCategory}` : title
const fullTitle = `${displayTitle} | ${siteTitle}`
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />

    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content={siteAuthor} />
    <meta name="twitter:title" content={displayTitle} />
    <meta name="twitter:description" content={metaDescription} />

    <link rel="icon" href="/icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2874fe" />

    {/* No-flash theme: set data-theme before paint, and re-apply after each
        client-side navigation (ClientRouter keeps the <html> element). */}
    <script is:inline>
      window.__applyTheme = function () {
        try {
          var t = localStorage.getItem("user-selected-theme")
          t = t ? JSON.parse(t) : null
          if (t !== "light" && t !== "dark") {
            t = matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark"
          }
          document.documentElement.dataset.theme = t
        } catch (e) {
          document.documentElement.dataset.theme = "dark"
        }
      }
      window.__applyTheme()
      document.addEventListener("astro:after-swap", window.__applyTheme)
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono&family=IBM+Plex+Sans:wght@400;700&family=Montserrat:wght@400;700&display=swap"
    />

    {/* Client-side (SPA-like) navigation, matching Gatsby's router. */}
    <ClientRouter />
    <script is:inline>
      // styled-components injects runtime <style> tags that Astro's head swap
      // would drop, leaving the next page unstyled. Move them into the incoming
      // document so they persist across client-side navigations.
      document.addEventListener("astro:before-swap", (event) => {
        document
          .querySelectorAll("style[data-styled]")
          .forEach((tag) => event.newDocument.head.appendChild(tag))
      })
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
