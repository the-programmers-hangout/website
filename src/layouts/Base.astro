---
import { ClientRouter } from "astro:transitions"
import "../styles/global.css"
import "prismjs/themes/prism-tomorrow.css"

export interface Props {
  title: string
  description?: string
  subCategory?: string | null
  lang?: string
}

const { title, description, subCategory, lang = "en" } = Astro.props

const siteTitle = "The Programmers Hangout"
const siteDescription = "A cozy community of programmers on Discord"
const siteAuthor = "TPH Community"

const metaDescription = description || siteDescription
const displayTitle = subCategory ? `${title} - ${subCategory}` : title
const fullTitle = `${displayTitle} | ${siteTitle}`
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />

    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content={siteAuthor} />
    <meta name="twitter:title" content={displayTitle} />
    <meta name="twitter:description" content={metaDescription} />

    <link rel="icon" href="/icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#202c36" />

    {/* No-flash theme: set data-theme before paint, re-apply after each
        client-side navigation (ClientRouter keeps the <html> element), and
        follow the OS setting live until the user picks a theme.
        theme-color follows data-theme so the browser UI matches --main-bg;
        the observer catches both this script and the toggle in
        ThemeToggler, and re-queries because ClientRouter swaps <head>. */}
    <script is:inline>
      new MutationObserver(function () {
        var meta = document.querySelector('meta[name="theme-color"]')
        if (meta) {
          meta.content =
            document.documentElement.dataset.theme === "light"
              ? "#ffffff"
              : "#202c36"
        }
      }).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["data-theme"],
      })
      window.__applyTheme = function () {
        try {
          var t = localStorage.getItem("user-selected-theme")
          t = t ? JSON.parse(t) : null
          if (t !== "light" && t !== "dark") {
            t = matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark"
          }
          document.documentElement.dataset.theme = t
        } catch (e) {
          document.documentElement.dataset.theme = "dark"
        }
      }
      window.__applyTheme()
      document.addEventListener("astro:after-swap", window.__applyTheme)
      matchMedia("(prefers-color-scheme: light)").addEventListener(
        "change",
        window.__applyTheme
      )
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,700;1,400;1,700&family=Montserrat:wght@400;700&display=swap"
    />

    {/* Client-side (SPA-like) navigation, matching Gatsby's router. */}
    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>
